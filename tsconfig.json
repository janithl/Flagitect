{
  "extends": "@react-native/typescript-config",
  "compilerOptions": {
    "allowJs": true,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "jsx": "react",
    "lib": ["es6"],
    "noEmit": true,
    "strict": true,
    "target": "esnext",
    "types": ["jest"],
    "paths": {
      "*": ["./src/*"],
      "@components": ["./src/components/index"],
      "@components/*": ["./src/components/*"],
      "@res/*": ["./src/res/*"],
      "@lib/*": ["./src/lib/*"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx"],
  "exclude": [
    "**/node_modules", 
    "**/Pods",
    "babel.config.js",
    "metro.config.js",
    "jest.config.js"
  ]
}
